# Copy this to .env.local and fill in your values
# These are the same values as apps/boba — same Supabase project

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_ID=brew

# Optional — each feature stays off until its key is set.
# Product analytics (PostHog project API key; host defaults to US cloud)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Error reporting (Sentry browser DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Shown on the privacy and terms pages
NEXT_PUBLIC_SUPPORT_EMAIL=
